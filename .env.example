# Copy this file to `.env` on the VM and fill in real values.
# `.env` itself is already gitignored - never commit it.

# -- Database --------------------------------------------------
DB_PASSWORD=change-me-to-a-strong-random-value

# -- Images (built & pushed by CI, pulled here by CD) ----------
BACKEND_IMAGE=ghcr.io/your-org-or-user/portfolio-backend
FRONTEND_IMAGE=ghcr.io/your-org-or-user/portfolio-frontend
IMAGE_TAG=latest

# -- Networking ------------------------------------------------
HTTP_PORT=80
# Comma-separated list accepted by CorsConfig - set to your real
# domain / ngrok URL once you have one.
CORS_ALLOWED_ORIGINS=http://localhost

# -- Optional: ngrok tunnel (docker compose --profile tunnel up -d) --
NGROK_AUTHTOKEN=
